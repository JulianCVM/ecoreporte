# Copiar a functions/.env.local (fuera de git): el emulador de Functions lo lee al arrancar.
# Tabla completa, rangos y efecto de cada parámetro: docs/05-parametrizacion.md («Servidor»).
# Todo lo que no esté aquí toma el valor por defecto de functions/src/config.ts.

# mock = sin red ni clave (pruebas y CI) · gemini-api = capa gratuita con clave (desarrollo)
AI_PROVIDER=mock
AI_ENABLED=true
AI_DAILY_LIMIT=200
AI_APPROVE_THRESHOLD=0.80
AI_REVIEW_THRESHOLD=0.50
# En local no hay credencial de FCM: las push se prueban desde la consola de Firebase.
FCM_ENABLED=false
# Bucket de las fotos: el `storage_bucket` de google-services.json. Sin esto, el emulador
# escucha <proyecto>.appspot.com y classifyReportPhoto nunca se dispara.
REPORTS_BUCKET=ecoreporte-dev.firebasestorage.app
