# Copiar a .env (fuera de git). Tabla completa en docs/05-parametrizacion.md
APP_VARIANT=development

# Cliente (se incrustan en el bundle: NUNCA poner secretos aquí)
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_USE_EMULATORS=true
# 10.0.2.2 = el PC visto desde el emulador de Android. En un celular físico, la IP del PC en la red local.
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Build (los lee app.config.ts; en EAS van como variables del entorno)
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
GOOGLE_MAPS_API_KEY=
